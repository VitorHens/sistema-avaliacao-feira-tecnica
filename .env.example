# Configure no ambiente do servidor; este arquivo é apenas uma referência.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=feira-tecnica2026
APP_BASE_PATH=/feira
PUBLIC_BASE_URL=https://seu-dominio.example/feira
NODE_ENV=production
TRUST_PROXY_HOPS=1
PROJECTS_DATA_FILE=./data/projetos-feira-2026.json
# JWT_SECRET deve ter ao menos 32 caracteres e ser guardado em segredo.
# VISITOR_TICKET_SECRET também deve ter ao menos 32 caracteres se houver vários servidores.
# BOOTSTRAP_ADMIN_EMAIL e BOOTSTRAP_ADMIN_PASSWORD são opcionais no primeiro início.
# Somente em ambiente local: ENABLE_TEST_PROFESSOR=true ativa o professor de teste.
